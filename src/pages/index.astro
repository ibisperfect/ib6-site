---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { site, services, approach } from '../data/site';
const cta = site.booking || `mailto:${site.email}`;
---
<Base>
  <section class="hero">
    <div class="container">
      <p class="eyebrow reveal">Independent consultancy · UK</p>
      <h1 class="display reveal">Strategy, AI and search —<br />built to compound.</h1>
      <p class="lead reveal">
        I help ambitious companies turn AI and search into measurable growth — from the boardroom
        decision to the systems that deliver it.
      </p>
      <div class="hero-actions reveal">
        <a class="btn btn-primary" href={cta}>Book a call</a>
        <a class="btn btn-ghost" href="/services">Explore services</a>
      </div>
      <div class="hero-rule reveal">
        <span><strong>AI & Corporate Strategy</strong></span>
        <span><strong>AI Architecture</strong></span>
        <span><strong>AI Automation</strong></span>
        <span><strong>SEO & Search Growth</strong></span>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">What I do</p>
          <h2 class="h2">Four disciplines.<br />One joined-up plan.</h2>
        </div>
        <p class="lead">
          Most firms buy strategy from one supplier, engineering from another and SEO from a third.
          I connect them — so the plan and the execution never drift apart.
        </p>
      </div>
      <div class="services reveal">
        {services.map((s) => (
          <a class="service" href={`/services#${s.id}`}>
            <span class="num">{s.index}</span>
            <h3 class="h3">{s.title}</h3>
            <p>{s.short}</p>
            <span class="more">Learn more</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">How I work</p>
          <h2 class="h2">From insight<br />to impact.</h2>
        </div>
        <p class="lead">A simple, transparent method. Senior attention from the first call to the final handover.</p>
      </div>
      <div class="steps">
        {approach.map((a) => (
          <div class="step reveal">
            <span class="num">{a.index}</span>
            <h3 class="h3">{a.title}</h3>
            <p class="muted">{a.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container founder">
      <div class="portrait reveal">
        <picture><source type="image/webp" srcset="/images/illia-600.webp 600w, /images/illia.webp 1200w" sizes="(max-width: 820px) 90vw, 40vw" /><img src="/images/illia.jpg" alt="Illia Bovkun, founder of IB6" width="1200" height="1500" loading="lazy" decoding="async" /></picture>
      </div>
      <div class="reveal">
        <p class="eyebrow">Who you work with</p>
        <p class="quote">
          “You work with me directly — no hand-offs to juniors, no layers. One person accountable for
          the thinking and the result.”
        </p>
        <p class="signature">Illia Bovkun<span>Founder & Principal Consultant</span></p>
        <p style="margin-top:28px"><a class="link-arrow" href="/about">More about me →</a></p>
      </div>
    </div>
  </section>

  <Cta />
</Base>

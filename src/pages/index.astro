---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import Portrait from '../components/Portrait.astro';
import Faq from '../components/Faq.astro';
import { site, services, approach, audiences, firstSteps, timeline, work, serviceSeo, homeFaqs } from '../data/site';
import { faqSchema } from '../data/schema';
---
<Base schema={[faqSchema(homeFaqs)]}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow reveal">AI automation for growing businesses</p>
        <h1 class="display reveal">AI automation<br />that <span class="grad">pays for itself.</span></h1>
        <p class="lead reveal">
          We help mid-sized businesses replace manual work with AI — and get found by the customers
          looking for them. Designed, built and run by a senior team.
        </p>
        <div class="hero-actions reveal">
          <a class="btn btn-primary" href={site.booking}>Book a free 30-min call</a>
          <a class="btn btn-ghost" href="#work">See our work</a>
        </div>
        <p class="hero-note reveal">Or write to <a class="link-arrow" href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <div class="hero-portrait reveal">
        <Portrait eager />
        <div class="photo-card">
          <div>
            <strong>Illia Bovkun</strong>
            <span>Founder, IB6</span>
          </div>
          <span class="status"><i></i>Taking on new projects</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight" style="padding-top:0">
    <div class="container">
      <ol class="timeline reveal">
        {timeline.map((t) => (
          <li>
            <span class="t-label">{t.label}</span>
            <span class="t-title">{t.title}</span>
            <span class="t-body">{t.body}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">What we do</p>
          <h2 class="h2">Strategy and execution.<br />One accountable team.</h2>
        </div>
        <p class="lead">
          Most companies buy strategy from one firm, engineering from another and SEO from a third — and the
          plan gets lost in between. We own all of it, end to end.
        </p>
      </div>
      <div class="services">
        {services.map((s) => (
          <a class="service reveal" href={`/services/${serviceSeo[s.id].slug}`}>
            <span class="num">{s.index}</span>
            <h3 class="h3">{s.title}</h3>
            <p>{s.short}</p>
            <span class="more">Learn more</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="work">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Selected work</p>
          <h2 class="h2">Built, shipped,<br />still running.</h2>
        </div>
        <p class="lead">Real businesses, real systems. Every project combines automation, a fast website and search.</p>
      </div>
      <div class="cards">
        {work.map((w) => (
          <article class="card work reveal">
            <p class="w-sector">{w.sector}</p>
            <h3 class="h3">{w.name}</h3>
            <p>{w.body}</p>
            <div class="tags">{w.tags.map((t) => <span>{t}</span>)}</div>
            {w.url && <a class="link-arrow w-link" href={w.url} rel="noopener" target="_blank">{w.url.replace('https://', '')} ↗</a>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Who we help</p>
          <h2 class="h2">Businesses that have outgrown manual work.</h2>
        </div>
        <p class="lead">If your team spends hours a week moving data between tools, we can probably give those hours back.</p>
      </div>
      <div class="cards">
        {audiences.map((a, i) => (
          <div class="card reveal">
            <div class="ico">{i + 1}</div>
            <h3 class="h3">{a.title}</h3>
            <p>{a.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">How we work</p>
          <h2 class="h2">From insight to impact.</h2>
        </div>
        <p class="lead">A simple, transparent method. Senior attention from the first call to the final handover.</p>
      </div>
      <div class="steps">
        {approach.map((a) => (
          <div class="step reveal">
            <span class="num">{a.index}</span>
            <h3 class="h3">{a.title}</h3>
            <p class="muted">{a.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container founder">
      <div class="reveal"><Portrait /></div>
      <div class="reveal">
        <p class="eyebrow">Who you work with</p>
        <p class="quote">“No hand-offs to juniors, no layers. You work directly with me and a small senior team — accountable for the thinking and the result.”</p>
        <p class="signature">Illia Bovkun<span>Founder, IB6</span></p>
        <p style="margin-top:28px"><a class="link-arrow" href="/about">Our story →</a></p>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Getting started</p>
          <h2 class="h2">Three steps. No obligation.</h2>
        </div>
      </div>
      <div class="steps three">
        {firstSteps.map((s) => (
          <div class="step reveal">
            <span class="num">Step {s.index}</span>
            <h3 class="h3">{s.title}</h3>
            <p class="muted">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Faq items={homeFaqs} />

  <Cta />
</Base>

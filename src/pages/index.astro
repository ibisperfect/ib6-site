---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import Portrait from '../components/Portrait.astro';
import { site, services, approach, audiences, firstSteps } from '../data/site';
---
<Base>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow reveal">AI strategy · Automation · Search</p>
        <h1 class="display reveal">AI that pays<br /><span class="grad">for itself.</span></h1>
        <p class="lead reveal">
          I help energy companies, startups and investors decide where AI creates real value —
          then build the systems and search presence that deliver it.
        </p>
        <div class="hero-actions reveal">
          <a class="btn btn-primary" href={site.booking}>Book a free 30-min call</a>
          <a class="btn btn-ghost" href="/services">See services</a>
        </div>
        <p class="hero-note reveal">Or write to <a class="link-arrow" href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <div class="hero-portrait reveal">
        <Portrait eager />
        <div class="badge"><strong>Illia Bovkun</strong>Founder · 10 years in oil & gas, VC and startups</div>
      </div>
    </div>
  </section>

  <section class="section-tight" style="padding-top:0">
    <div class="container">
      <div class="proof reveal">
        <div><span class="big">10+</span><span class="small">years of experience</span></div>
        <div><span class="big">Oil & Gas</span><span class="small">operations at scale</span></div>
        <div><span class="big">VC</span><span class="small">investment judgement</span></div>
        <div><span class="big">Startups</span><span class="small">speed of execution</span></div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">What I do</p>
          <h2 class="h2">Strategy and execution.<br />One accountable partner.</h2>
        </div>
        <p class="lead">
          Most companies buy strategy from one firm, engineering from another and SEO from a third — and the
          plan gets lost in between. I own all of it, end to end.
        </p>
      </div>
      <div class="services">
        {services.map((s) => (
          <a class="service reveal" href={`/services#${s.id}`}>
            <span class="num">{s.index}</span>
            <h3 class="h3">{s.title}</h3>
            <p>{s.short}</p>
            <span class="more">Learn more</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Who I work with</p>
          <h2 class="h2">Built for three kinds of client.</h2>
        </div>
        <p class="lead">Each draws directly on a part of my background — so I speak your language from the first call.</p>
      </div>
      <div class="cards">
        {audiences.map((a, i) => (
          <div class="card reveal">
            <div class="ico">{i + 1}</div>
            <h3 class="h3">{a.title}</h3>
            <p>{a.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">How I work</p>
          <h2 class="h2">From insight to impact.</h2>
        </div>
        <p class="lead">A simple, transparent method. Senior attention from the first call to the final handover.</p>
      </div>
      <div class="steps">
        {approach.map((a) => (
          <div class="step reveal">
            <span class="num">{a.index}</span>
            <h3 class="h3">{a.title}</h3>
            <p class="muted">{a.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container founder">
      <div class="reveal"><Portrait /></div>
      <div class="reveal">
        <p class="eyebrow">Who you work with</p>
        <p class="quote">“No hand-offs to juniors, no layers. You work with me directly — one person accountable for the thinking and the result.”</p>
        <p class="signature">Illia Bovkun<span>Founder & Principal Consultant, IB6</span></p>
        <p style="margin-top:28px"><a class="link-arrow" href="/about">My background →</a></p>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Getting started</p>
          <h2 class="h2">Three steps. No obligation.</h2>
        </div>
      </div>
      <div class="steps three">
        {firstSteps.map((s) => (
          <div class="step reveal">
            <span class="num">Step {s.index}</span>
            <h3 class="h3">{s.title}</h3>
            <p class="muted">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Cta />
</Base>

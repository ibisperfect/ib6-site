---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { approach, firstSteps } from '../data/site';
---
<Base title="Approach" description="How IB6 works: diagnose, decide, build, compound.">
  <section class="hero">
    <div class="container">
      <p class="eyebrow reveal">Approach</p>
      <h1 class="display reveal">Clear thinking.<br /><span class="grad">Working systems.</span></h1>
      <p class="lead reveal">Advice that stops at slides rarely changes anything. We stay through delivery — and measure what changed.</p>
    </div>
  </section>

  <section class="section-tight" style="padding-top:0">
    <div class="container">
      {approach.map((a) => (
        <article class="detail reveal">
          <div><span class="num">{a.index}</span><h2 class="h2">{a.title}</h2></div>
          <div><p class="lead">{a.body}</p></div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-dark">
    <div class="container">
      <div class="section-head reveal"><div><p class="eyebrow">Principles</p><h2 class="h2">What you can expect.</h2></div></div>
      <div class="cards">
        <div class="card reveal"><h3 class="h3">Outcomes over output</h3><p>Every recommendation is tied to revenue, cost or risk — not to activity.</p></div>
        <div class="card reveal"><h3 class="h3">Honest advice</h3><p>If AI isn’t the answer, we’ll say so. If we’re not the right fit, we’ll tell you who is.</p></div>
        <div class="card reveal"><h3 class="h3">No lock-in</h3><p>Documented decisions and trained people, so you never depend on us.</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head reveal"><div><p class="eyebrow">Getting started</p><h2 class="h2">Three steps. No obligation.</h2></div></div>
      <div class="steps three">
        {firstSteps.map((s) => (
          <div class="step reveal"><span class="num">Step {s.index}</span><h3 class="h3">{s.title}</h3><p class="muted">{s.body}</p></div>
        ))}
      </div>
    </div>
  </section>

  <Cta />
</Base>

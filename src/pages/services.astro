---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { services, engagements } from '../data/site';
---
<Base title="Services" description="AI & corporate strategy, AI architecture, AI automation and SEO — delivered by one senior consultant.">
  <section class="hero">
    <div class="container">
      <p class="eyebrow reveal">Services</p>
      <h1 class="display reveal">Senior expertise,<br />end to end.</h1>
      <p class="lead reveal">Choose one discipline or combine them. Every engagement starts with the business outcome, not the technology.</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      {services.map((s) => (
        <article class="detail reveal" id={s.id}>
          <div>
            <span class="num">{s.index}</span>
            <h2 class="h2" style="font-size:clamp(30px,3.4vw,44px);margin-top:12px">{s.title}</h2>
          </div>
          <div>
            <p class="lead" style="max-width:none">{s.body}</p>
            <ul>{s.outcomes.map((o) => <li>{o}</li>)}</ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Ways to work together</p>
          <h2 class="h2">Engagement models</h2>
        </div>
        <p class="lead">Fixed scope, clear deliverables, transparent pricing agreed upfront.</p>
      </div>
      <div class="cards">
        {engagements.map((e) => (
          <div class="card reveal">
            <h3 class="h3">{e.title}</h3>
            <p class="dur">{e.duration}</p>
            <p>{e.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Cta />
</Base>

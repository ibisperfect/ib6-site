---
import { nav, site } from '../data/site';
import Logo from './Logo.astro';
const path = Astro.url.pathname.replace(/\/$/, '');
---
<header class="site-header">
  <div class="container bar">
    <Logo size={32} />
    <button class="menu-toggle" aria-label="Menu" aria-expanded="false"><span></span><span></span></button>
    <nav class="nav" aria-label="Main">
      {nav.map((n) => (
        <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
      ))}
      <a class="btn btn-primary" href={site.booking}>Book a call</a>
    </nav>
  </div>
</header>

---
// Visible FAQ — the same Q&A is emitted as FAQPage schema by the page (see faqSchema).
interface Props { items: { q: string; a: string }[]; title?: string; }
const { items, title = 'Frequently asked questions' } = Astro.props;
---
<section class="section">
  <div class="container faq-wrap">
    <div class="reveal"><p class="eyebrow">FAQ</p><h2 class="h2">{title}</h2></div>
    <div class="faq reveal">
      {items.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

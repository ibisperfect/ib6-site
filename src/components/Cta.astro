---
import { site } from '../data/site';
interface Props { title?: string; text?: string; }
const {
  title = 'Where could AI move the needle for you?',
  text = 'Tell me where you want to be in twelve months. In 30 minutes I’ll tell you honestly whether I can help — and how.',
} = Astro.props;
---
<section class="section section-dark cta">
  <div class="container reveal">
    <p class="eyebrow">Start a conversation</p>
    <h2 class="h2">{title}</h2>
    <p class="lead">{text}</p>
    <div class="cta-actions">
      <a class="btn btn-primary" href={site.booking}>Book a free 30-min call</a>
      <a class="btn btn-ghost-light" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
</section>

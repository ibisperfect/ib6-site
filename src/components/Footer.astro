---
import { nav, site } from '../data/site';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div>
        <Logo size={34} />
        <p class="footer-tag">AI automation for growing businesses.</p>
        <p style="margin:6px 0 0"><a href={`mailto:${site.email}`} class="footer-mail">{site.email}</a></p>
      </div>
      <div class="footer-links">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        {site.linkedin && <a href={site.linkedin} rel="noopener">LinkedIn</a>}
        <a href="/privacy">Privacy</a>
      </div>
    </div>
    <p class="legal">
      © {year} {site.legalName}. {site.legalName} is a private limited company registered in England and Wales,
      company number {site.companyNumber}. Registered office: {site.registeredOffice}.
    </p>
  </div>
</footer>

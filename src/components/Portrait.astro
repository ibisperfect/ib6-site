---
interface Props { alt?: string; eager?: boolean; }
const { alt = 'Illia Bovkun, founder of IB6', eager = false } = Astro.props;
---
<div class="portrait">
  <picture>
    <source type="image/webp" srcset="/images/illia-600.webp 600w, /images/illia.webp 1200w" sizes="(max-width: 900px) 90vw, 40vw" />
    <img src="/images/illia.jpg" alt={alt} width="1200" height="1500"
      loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" />
  </picture>
</div>
